# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Never commit .env.local — it's gitignored.
#
# Only the publishable (anon) key is used here. All writes are gated by
# Supabase Auth + Row Level Security policies (see supabase-setup.sql),
# so no service_role/secret key is ever needed by this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
